# Temporary normal-boot observer, started directly by init before its action queue.
type rhodep_bootlog, domain, coredomain;
type rhodep_bootlog_exec, exec_type, file_type, system_file_type;
type rhodep_bootlog_data_file, file_type;

init_daemon_domain(rhodep_bootlog)

# The native observer creates its own tree before init runs any restorecon action.
# Only the named child of /metadata gets this type; subsequent files inherit it.
allow rhodep_bootlog metadata_file:dir { search getattr write add_name };
type_transition rhodep_bootlog metadata_file:dir rhodep_bootlog_data_file "rhodep-bootlogs";
type_transition rhodep_bootlog rhodep_bootlog_data_file:dir rhodep_bootlog_data_file;
type_transition rhodep_bootlog rhodep_bootlog_data_file:file rhodep_bootlog_data_file;
allow rhodep_bootlog rhodep_bootlog_data_file:dir create_dir_perms;
allow rhodep_bootlog rhodep_bootlog_data_file:file create_file_perms;
allow rhodep_bootlog labeledfs:filesystem getattr;

# /dev/kmsg is a separate reader cursor; the observer never clears the ring.
allow rhodep_bootlog kmsg_device:chr_file r_file_perms;
allow rhodep_bootlog kernel:system syslog_read;
allow rhodep_bootlog self:global_capability2_class_set syslog;

# Connect directly to logd, independently of the init action queue or a shell.
read_logd(rhodep_bootlog)
read_runtime_log_tags(rhodep_bootlog)

# Read the boot/USB progress properties included in the bounded status snapshot.
# Bootloader, build and public init-service properties are already readable by
# all domains. Vendor-private service properties remain deliberately ungranted.
get_prop(rhodep_bootlog, apex_ready_prop)
get_prop(rhodep_bootlog, apexd_prop)
get_prop(rhodep_bootlog, boot_status_prop)
get_prop(rhodep_bootlog, bootanim_system_prop)
get_prop(rhodep_bootlog, persistent_properties_ready_prop)
get_prop(rhodep_bootlog, init_service_status_private_prop)
get_prop(rhodep_bootlog, usb_control_prop)
get_prop(rhodep_bootlog, ffs_control_prop)
get_prop(rhodep_bootlog, system_prop)

# Enumerate proc and read only the startup processes the collector selects.
# Stack/syscall access that requires ptrace remains best effort and ungranted.
allow rhodep_bootlog proc:dir r_dir_perms;
allow rhodep_bootlog proc:lnk_file r_file_perms;
allow rhodep_bootlog { proc_cmdline proc_mounts proc_modules }:file r_file_perms;
allow rhodep_bootlog proc_mounts:lnk_file r_file_perms;
allow rhodep_bootlog {
    init kernel apexd logd adbd zygote system_server bootanim surfaceflinger
    modprobe vendor_modprobe ueventd
}:dir r_dir_perms;
allow rhodep_bootlog {
    init kernel apexd logd adbd zygote system_server bootanim surfaceflinger
    modprobe vendor_modprobe ueventd
}:file { getattr open read };

# Read existing UDC/configfs state without changing gadget configuration.
allow rhodep_bootlog { sysfs sysfs_android_usb sysfs_usb }:dir r_dir_perms;
allow rhodep_bootlog { sysfs sysfs_android_usb sysfs_usb }:file r_file_perms;
allow rhodep_bootlog configfs:dir search;
allow rhodep_bootlog configfs:file r_file_perms;

# Recovery may export a failed normal boot's capture, but does not create it.
recovery_only(`
    allow { recovery adbd shell } metadata_file:dir search;
    allow { recovery adbd shell } rhodep_bootlog_data_file:dir r_dir_perms;
    allow { recovery adbd shell } rhodep_bootlog_data_file:file r_file_perms;
')
