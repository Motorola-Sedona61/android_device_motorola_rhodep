on property:ro.debuggable=1 && property:ro.adb.secure=0 && property:ro.persistent_properties.ready=true
    setprop sys.usb.configfs 1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

on post-fs
    # Sensors
    chown system system /sys/devices/platform/soc/4a80000.spi/spi_master/spi0/spi0.0/touchscreen/primary/double_tap_enabled
    chown system system /sys/devices/platform/soc/4a80000.spi/spi_master/spi0/spi0.0/touchscreen/primary/double_tap_pressed

# Linux 6.1 keeps every vendor module in /vendor/lib/modules.
on fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules \
        goodix_brl_mmi mmi_charger bq2597x_mmi_iio mmi_discrete_charger_class sgm4154x_charger bq2589x_charger mmi_discrete_charger qpnp_adaptive_charge tcpc_class tcpc_rt1711h tcpc_sgm7220 rt_pd_manager mmi_discrete_turbo_charger

on charger
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules \
        mmi_charger bq2597x_mmi_iio mmi_discrete_charger_class sgm4154x_charger bq2589x_charger mmi_discrete_charger qpnp_adaptive_charge tcpc_class tcpc_rt1711h tcpc_sgm7220 rt_pd_manager mmi_discrete_turbo_charger

service capsense_reset /vendor/bin/capsense_reset
    class core
    user system
    group system input
    disabled

on property:sys.boot_completed=1
    start capsense_reset
