# Audio
persist.vendor.audio.fluence.voicecomm=false
persist.vendor.audio.stereo_speaker.spin.enable=true

# Camera
persist.vendor.camera.physical.num=4

# Display
debug.sf.enable_hwc_vds=1
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.wcg_composition_dataspace=143261696
ro.vendor.display.foss=1
vendor.display.disable_sdr_dimming=0
vendor.display.enable_brightness_drm_prop=1
vendor.display.foss.config=1

# Radio
ro.vendor.radio.imei.sv=26

# Sensors
ro.vendor.sensors.mot_ltv=true
